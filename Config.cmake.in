@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_@PACKAGE_NAME@_supported_components @SUPPORTED_COMPONENTS@)
set(_@PACKAGE_NAME@_component_root "${CMAKE_CURRENT_LIST_DIR}")

list(GET _@PACKAGE_NAME@_supported_components 0 _@PACKAGE_NAME@_first_component)
if(NOT EXISTS "${_@PACKAGE_NAME@_component_root}/${_@PACKAGE_NAME@_first_component}/${_@PACKAGE_NAME@_first_component}Targets.cmake"
   AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/../${_@PACKAGE_NAME@_first_component}/${_@PACKAGE_NAME@_first_component}Targets.cmake")
    get_filename_component(_@PACKAGE_NAME@_component_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
unset(_@PACKAGE_NAME@_first_component)

if(NOT @PACKAGE_NAME@_FIND_COMPONENTS)
    set(@PACKAGE_NAME@_FIND_COMPONENTS ${_@PACKAGE_NAME@_supported_components})
endif()

foreach(_comp IN LISTS @PACKAGE_NAME@_FIND_COMPONENTS)
    list(FIND _@PACKAGE_NAME@_supported_components ${_comp} _index)
    if(_index EQUAL -1)
        set(@PACKAGE_NAME@_${_comp}_FOUND FALSE)
        if(@PACKAGE_NAME@_FIND_REQUIRED_${_comp})
            set(@PACKAGE_NAME@_FOUND FALSE)
            set(@PACKAGE_NAME@_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
        endif()
        continue()
    endif()

    if(EXISTS "${_@PACKAGE_NAME@_component_root}/${_comp}/${_comp}Dependencies.cmake")
        include("${_@PACKAGE_NAME@_component_root}/${_comp}/${_comp}Dependencies.cmake")
        set(_resolve_func "resolve_${_comp}_dependencies")
        if(COMMAND ${_resolve_func})
            cmake_language(CALL ${_resolve_func})
        endif()
    endif()

    include("${_@PACKAGE_NAME@_component_root}/${_comp}/${_comp}Targets.cmake")

    set(_@PACKAGE_NAME@_deps_var "${_comp}_PUBLIC_DEPENDENCIES")
    if(TARGET @PACKAGE_NAME@::${_comp} AND DEFINED ${_@PACKAGE_NAME@_deps_var})
        target_link_libraries(@PACKAGE_NAME@::${_comp} INTERFACE ${${_@PACKAGE_NAME@_deps_var}})
    endif()
    unset(_@PACKAGE_NAME@_deps_var)

    set(@PACKAGE_NAME@_${_comp}_FOUND TRUE)
endforeach()

check_required_components(@PACKAGE_NAME@)
unset(_@PACKAGE_NAME@_component_root)
